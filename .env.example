SECRET_KEY=change-this-to-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Optional: friendly name shown in the top-right corner instead of ADMIN_USERNAME
ADMIN_DISPLAY_NAME=Nishat Urmi

# Leave empty to use local SQLite (data/invenex.db).
# For a real deployment, set this to a free Postgres URL (e.g. from Neon.tech).
DATABASE_URL=

# ---- Google Drive / Sheets backup (optional) ----
# Service account key: use the FILE path locally, the JSON blob on a host.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Drive folder that holds invenex.db (the real backup). Empty = off.
GDRIVE_FOLDER_ID=
# Spreadsheet that mirrors every table into a readable tab. Empty = off.
GSHEET_ID=

# Tuning (safe to leave as-is)
GDRIVE_DB_NAME=invenex.db
BACKUP_DEBOUNCE_SECONDS=5
GDRIVE_SNAPSHOT_KEEP=14   # how many daily versions to pin in Drive
SHEET_SYNC_SECONDS=300
